# LeadHunt Environment Configuration

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=leadhunt
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadhunt

# Scraping Settings
MAX_CONCURRENCY=5
REQUEST_TIMEOUT_SECONDS=15
MAX_RESULTS_PER_SEARCH=50

# Optional Google Places API Key (leave empty to use public OpenStreetMap & Web Search)
GOOGLE_PLACES_API_KEY=
